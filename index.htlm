<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Gold Prices Plot</title>
  <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
</head>
<body style="font-family: sans-serif; margin: 40px;">
  <h2>Gold Prices (Hourly, Interpolated)</h2>
  <div id="plot" style="width:100%;max-width:1000px;height:600px;"></div>

  <script>
  // === CONFIGURATION ===
  const CSV_URL = "https://raw.githubusercontent.com/username/repo/main/data.csv"; // <- change to your real raw CSV URL
  const TIMEZONE_OFFSET = 3 * 60 * 60 * 1000; // adjust if your timestamps include +03:00, etc.

  // === HELPER FUNCTIONS ===
  function parseCSV(text) {
    const lines = text.trim().split("\n");
    const headers = lines[0].split(/\s+/);
    return lines.slice(1).map(line => {
      const parts = line.split(/\s+/);
      const obj = {};
      headers.forEach((h, i) => obj[h] = parts[i]);
      return obj;
    });
  }

  function roundToHour(date) {
    const d = new Date(date);
    d.setMinutes(0, 0, 0);
    return d;
  }

  function interpolateToHourly(data) {
    // group by site
    const grouped = {};
    for (const row of data) {
      const site = row.site;
      if (!grouped[site]) grouped[site] = [];
      grouped[site].push({
        t: new Date(row.timestamp),
        buy: parseFloat(row.buy),
        sell: parseFloat(row.sell)
      });
    }

    const hourlyData = {};
    for (const site in grouped) {
      const siteData = grouped[site].sort((a, b) => a.t - b.t);
      const start = roundToHour(siteData[0].t);
      const end = roundToHour(siteData[siteData.length - 1].t);
      const points = [];

      for (let t = new Date(start); t <= end; t = new Date(t.getTime() + 3600 * 1000)) {
        // find nearest points before and after
        let before = null, after = null;
        for (const p of siteData) {
          if (p.t <= t) before = p;
          if (p.t >= t) { after = p; break; }
        }

        if (before && after) {
          if (before.t.getTime() === after.t.getTime()) {
            points.push({ t, buy: before.buy, sell: before.sell });
          } else {
            const ratio = (t - before.t) / (after.t - before.t);
            const interpBuy = before.buy + (after.buy - before.buy) * ratio;
            const interpSell = before.sell + (after.sell - before.sell) * ratio;
            points.push({ t, buy: interpBuy, sell: interpSell });
          }
        } else if (before) {
          points.push({ t, buy: before.buy, sell: before.sell });
        } else if (after) {
          points.push({ t, buy: after.buy, sell: after.sell });
        }
      }
      hourlyData[site] = points;
    }
    return hourlyData;
  }

  async function main() {
    const text = await fetch(CSV_URL).then(r => r.text());
    const data = parseCSV(text);
    const hourly = interpolateToHourly(data);

    const traces = [];
    for (const site in hourly) {
      const d = hourly[site];
      const times = d.map(p => p.t);
      const buys = d.map(p => p.buy);
      const sells = d.map(p => p.sell);

      traces.push({
        x: times,
        y: buys,
        mode: "lines+markers",
        name: `${site} (buy)`
      });
      traces.push({
        x: times,
        y: sells,
        mode: "lines+markers",
        name: `${site} (sell)`
      });
    }

    Plotly.newPlot("plot", traces, {
      title: "Gold Prices by Site (Hourly, Interpolated)",
      xaxis: { title: "Time" },
      yaxis: { title: "Price (BGN)" },
      hovermode: "x unified"
    });
  }

  main();
  </script>
</body>
</html>
